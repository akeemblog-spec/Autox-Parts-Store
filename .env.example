# Supabase/PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Auth.js / NextAuth secret. Generate a strong random value for each environment.
AUTH_SECRET="replace-with-a-strong-random-secret"

# Local or deployed application URL
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Transactional email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="AutoX Parts Store <noreply@your-verified-domain.com>"

APP_URL="http://localhost:3000"
MFA_ENCRYPTION_KEY="replace-with-a-long-random-secret"
MFA_PROOF_SECRET="replace-with-a-long-random-secret"
